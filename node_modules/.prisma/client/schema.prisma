generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

/// Adhésion du compte Facebook (profil) au groupe, renseignée par l'extension.
enum JoinStatus {
  NOT_JOINED
  REQUESTED
  JOINED
  QUESTIONS
  FAILED
}

enum PostStatus {
  DRAFT
  AVAILABLE
  ARCHIVED
}

enum SourceType {
  MANUAL
  OPENAI
  JSON
  FACEBOOK
}

enum TargetStatus {
  AVAILABLE
  CLAIMED
  CONSUMED
  PUBLISHED
  FAILED
  CANCELLED
}

enum JobStatus {
  CLAIMED
  /// Tout est publié et commenté : il reste à basculer les commentaires sur l'URL.
  AWAITING_LINK
  PARTIALLY_COMPLETED
  COMPLETED
  FAILED
  EXPIRED
}

/// Étapes d'une reprise : chacune est le point de reprise après une panne.
enum IngestStatus {
  PENDING_SCRAPE
  SCRAPING
  SCRAPED
  REWRITING
  REWRITTEN
  PUBLISHING
  AWAITING_ECHO
  COMPLETED
  FAILED
}

/// Un ADMIN voit et gère tout. Un MANAGER ne voit que ce qu'il possède et
/// ce qu'on a partagé avec lui.
enum Role {
  ADMIN
  MANAGER
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

/// Ce que l'admin veut d'un profil. AUTO = il publie dans sa fenetre horaire,
/// ON = tout de suite et sans fenetre, OFF = il s'arrete.
enum RunnerMode {
  OFF
  ON
  AUTO
}

/// Ou en est le navigateur du profil, tel que l'agent local le rapporte.
/// L'API ne peut pas l'ouvrir elle-meme : le client NSTBrowser n'ecoute que
/// sur la machine ou il tourne.
enum BrowserState {
  STOPPED
  STARTING
  RUNNING
  ERROR
}

/// Un compte de la plateforme. Le premier ADMIN naît des identifiants du
/// `.env` à la première connexion : une installation existante n'a rien à
/// faire pour continuer à fonctionner.
/// Le contrôle d'une publication par le profil vérificateur.
enum VerifyStatus {
  OK // le post est en ligne, avec son commentaire et son lien
  REPUBLISHED // introuvable ou sans lien : remis dans la file pour republication
  NEEDS_ACTION // à régler à la main (suppression refusée, republications épuisées…)
}

/// L'état de l'extension WordPress d'un site, vu depuis la plateforme.
enum PluginState {
  UNKNOWN // jamais vérifié
  CONNECTED // la route répond et accepte la clé
  BAD_KEY // l'extension répond, mais refuse la clé
  MISSING // pas d'extension (ou désactivée)
  OUTDATED // ancienne extension (< 1.2.2) : envoie ses articles, sans route de statut ni réception des reprises
  UNREACHABLE // le site ne répond pas
}

/// Le thème commun à des groupes et des sites : c'est lui qui relie un
/// article à ses groupes de diffusion. Une liste gérée, pour qu'un « Recettes »
/// et un « recette » ne fassent pas deux thèmes.
model Category {
  id        String          @id @default(cuid())
  name      String          @unique
  groups    Group[]
  sites     ContentSource[]
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  visuals   Visual[]

  @@map("categories")
}

model User {
  id            String          @id @default(cuid())
  username      String          @unique
  /// `sel:empreinte`, scrypt. Le mot de passe n'est jamais stocké.
  passwordHash  String          @map("password_hash")
  role          Role            @default(MANAGER)
  status        RecordStatus    @default(ACTIVE)
  /// Sa clé d'automatisation : son extension et son automate ne verront que
  /// son périmètre. Une clé par compte, sans quoi chacun atteindrait la file
  /// de tous les autres.
  automationKey String          @unique @map("automation_key")
  /// La clé de l'API locale de NSTBrowser de ce compte. L'agent local la
  /// reçoit avec son plan, profil par profil : chaque compte ouvre ses
  /// navigateurs avec son propre abonnement, sans toucher au `.env` de la
  /// machine. NULL = l'agent retombe sur son `NST_API_KEY`.
  nstApiKey     String?         @map("nst_api_key")
  /// Ce que ce compte possède. Supprimer un compte ne détruit rien : ses
  /// ressources deviennent sans propriétaire, donc réservées aux ADMIN, qui
  /// peuvent les réattribuer.
  sessions      Session[]
  profiles      Profile[]
  groups        Group[]
  posts         Post[]
  sites         ContentSource[]
  ingests       SourceIngest[]
  /// Ce qu'on lui a partagé. Publier seulement : ni renommer, ni
  /// désactiver, ni supprimer, ni repartager.
  groupAccess   GroupAccess[]
  siteAccess    SiteAccess[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  visuals       Visual[]

  @@index([status])
  @@map("users")
}

model Profile {
  id                       String           @id @default(cuid())
  name                     String
  externalId               String?          @unique @map("external_id")
  defaultImageUrl          String?          @map("default_image_url")
  minPostsPerJob           Int              @default(2) @map("min_posts_per_job")
  maxPostsPerJob           Int              @default(6) @map("max_posts_per_job")
  /// Seuils d'alimentation propres au profil. NULL = suivre le réglage global.
  minimumAvailable         Int?             @map("minimum_available")
  minimumAvailablePerGroup Int?             @map("minimum_available_per_group")
  /// Qui possède cette ressource. NULL = sans propriétaire : seuls les
  /// ADMIN la voient, en attendant qu'on la réattribue.
  ownerId                  String?          @map("owner_id")
  owner                    User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  status                   RecordStatus     @default(ACTIVE)
  /// Le profil vérificateur : il ouvre les posts publiés pour contrôler
  /// qu'ils sont en ligne avec leur lien, et supprime ceux qui ne l'ont pas.
  /// Il doit être administrateur ou modérateur des groupes contrôlés.
  isModerator              Boolean          @default(false) @map("is_moderator")
  /// Réglages du modérateur, pilotés depuis sa rubrique (ADMIN seulement) ;
  /// son extension les relit chaque minute.
  moderatorPaused          Boolean          @default(false) @map("moderator_paused")
  /// Un passage demandé par l'admin : l'extension le lance à sa prochaine
  /// relecture (dans la minute).
  moderatorRunAt           DateTime?        @map("moderator_run_at")
  /// Idem pour les tâches « nos profils » (adhésions, pré-approbations,
  /// contrôles), séparées de la vérification des posts.
  moderatorMembersRunAt    DateTime?        @map("moderator_members_run_at")
  moderatorBatch           Int              @default(3) @map("moderator_batch")
  moderatorEveryMinutes    Int              @default(25) @map("moderator_every_minutes")
  moderatorMembers         Boolean          @default(true) @map("moderator_members")
  /// Un rythme humain : il ne travaille qu'entre ces heures (minutes depuis
  /// minuit, dans son fuseau), et pas plus de N actions par heure / par jour.
  /// Facebook a désactivé un compte modérateur qui agissait 24 h/24.
  moderatorWindowStart     Int              @default(540) @map("moderator_window_start")
  moderatorWindowEnd       Int              @default(1320) @map("moderator_window_end")
  moderatorTimezone        String           @default("Europe/Paris") @map("moderator_timezone")
  moderatorHourlyLimit     Int              @default(12) @map("moderator_hourly_limit")
  moderatorDailyLimit      Int              @default(60) @map("moderator_daily_limit")
  /// Dernière relecture par son extension : en ligne ou non.
  moderatorSeenAt          DateTime?        @map("moderator_seen_at")
  moderatorAgent           String?          @map("moderator_agent")
  /// L'identifiant numérique du compte Facebook de ce profil (cookie
  /// `c_user`), remonté par l'extension de publication. C'est LUI, jamais le
  /// nom, qui désigne nos profils au vérificateur : un nom se partage.
  facebookUserId           String?          @unique @map("facebook_user_id")
  facebookName             String?          @map("facebook_name")
  facebookSeenAt           DateTime?        @map("facebook_seen_at")
  /// Son pilotage : marche/arret, fenetre horaire, et ce que son navigateur
  /// rapporte. Absent = jamais pilote (donc a l'arret).
  runner                   ProfileRunner?
  profileGroups            ProfileGroup[]
  posts                    Post[]
  forcedTargets            PostTarget[]     @relation("ForcedTargets")
  publicationJobs          PublicationJob[]
  logs                     ActivityLog[]
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("profiles")
}

model Group {
  id              String           @id @default(cuid())
  name            String
  externalId      String?          @unique @map("external_id")
  url             String
  ownerId         String?          @map("owner_id")
  owner           User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /// Le thème du groupe. Un article reçu d'un site de la même catégorie
  /// devient un post qui vise tous ces groupes à la fois.
  categoryId      String?          @map("category_id")
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status          RecordStatus     @default(ACTIVE)
  /// Les groupes servis en premier : plus haut = un profil y va avant les
  /// autres. 0 = normal. Réglé dans Pilotage → Règles & priorités.
  priority        Int              @default(0)
  /// Au plus N publications par jour dans ce groupe (jour du fuseau de
  /// l'objectif). NULL = pas de plafond.
  dailyCap        Int?             @map("daily_cap")
  /// Heures où l'on publie dans ce groupe (minutes depuis minuit, fuseau de
  /// l'objectif ; une plage peut passer minuit). NULL = à toute heure.
  hoursStart      Int?             @map("hours_start")
  hoursEnd        Int?             @map("hours_end")
  /// La langue des membres (code ISO : en, fr, ar, es…). Les posts
  /// « engagement » ne vont qu'aux groupes de la langue choisie.
  language        String?
  profiles        ProfileGroup[]
  targets         PostTarget[]
  publicationJobs PublicationJob[]
  logs            ActivityLog[]
  access          GroupAccess[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@index([ownerId])
  @@index([categoryId])
  @@map("groups")
}

/// Un groupe partagé avec un compte, en publication seule. Une table par
/// ressource plutôt qu'un système de permissions générique : les requêtes
/// restent lisibles, et on voit d'un coup d'œil qui a accès à quoi.
model GroupAccess {
  id        String   @id @default(cuid())
  groupId   String   @map("group_id")
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Qui a partagé, pour que le propriétaire sache d'où vient un accès.
  grantedBy String?  @map("granted_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_access")
}

model ProfileGroup {
  id                   String       @id @default(cuid())
  profileId            String       @map("profile_id")
  profile              Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  groupId              String       @map("group_id")
  group                Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status               RecordStatus @default(ACTIVE)
  joinStatus           JoinStatus   @default(NOT_JOINED) @map("join_status")
  joinCheckedAt        DateTime?    @map("join_checked_at")
  joinError            String?      @map("join_error") @db.Text
  /// Le vérificateur (admin/modérateur du groupe) a accepté la demande
  /// d'adhésion de ce profil.
  memberApprovedAt     DateTime?    @map("member_approved_at")
  /// Le vérificateur a « pré-approuvé » ce profil : ses posts paraissent sans
  /// passer par la validation des modérateurs.
  preApprovedAt        DateTime?    @map("pre_approved_at")
  /// Le dernier essai du vérificateur, et pourquoi il a échoué.
  memberActionError    String?      @map("member_action_error") @db.Text
  memberActionAt       DateTime?    @map("member_action_at")
  /// Réservé par un vérificateur jusqu'à cette heure (ou repoussé).
  memberClaimedUntil   DateTime?    @map("member_claimed_until")
  memberAttempts       Int          @default(0) @map("member_attempts")
  /// L'admin a demandé cette action au modérateur (accepter / pré-approuver) :
  /// elle passe en tête de sa file. Effacé au rapport.
  memberRequestedAt    DateTime?    @map("member_requested_at")
  /// Contrôle de la pré-approbation demandé par l'admin : `check` = regarder
  /// sans rien cliquer, `fix` = regarder puis pré-approuver ce qui manque.
  auditRequestedAt     DateTime?    @map("audit_requested_at")
  auditMode            String?      @map("audit_mode")
  auditClaimedUntil    DateTime?    @map("audit_claimed_until")
  /// Ce que le dernier contrôle a vu sur Facebook : PREAPPROVED,
  /// NOT_PREAPPROVED, NO_PERMISSION, NOT_FOUND.
  preApprovalState     String?      @map("pre_approval_state")
  preApprovalCheckedAt DateTime?    @map("pre_approval_checked_at")
  preApprovalDetail    String?      @map("pre_approval_detail") @db.Text
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  @@unique([profileId, groupId])
  @@index([groupId, status])
  @@index([profileId, joinStatus])
  @@map("profile_groups")
}

model Post {
  id               String               @id @default(cuid())
  /// NULL = post ouvert : n'importe quel profil qui a rejoint l'un de ses
  /// groupes peut le publier, et chaque groupe ne le reçoit qu'une fois.
  profileId        String?              @map("profile_id")
  profile          Profile?             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// À qui appartient un post ouvert (il n'a pas de profil pour le dire).
  /// Seuls les profils de ce compte le publient. NULL = tous.
  ownerId          String?              @map("owner_id")
  owner            User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  title            String
  description      String               @db.Text
  url              String?
  imageUrl         String?              @map("image_url")
  delay            Int
  sourceType       SourceType           @default(MANUAL) @map("source_type")
  externalId       String?              @map("external_id")
  status           PostStatus           @default(AVAILABLE)
  rawData          Json?                @map("raw_data")
  articleId        String?              @map("article_id")
  article          Article?             @relation(fields: [articleId], references: [id], onDelete: SetNull)
  /// Le visuel d'où vient ce post (rubrique Articles → Visuels) : une image
  /// seule, sans article ni lien.
  visualId         String?              @map("visual_id")
  visual           Visual?              @relation(fields: [visualId], references: [id], onDelete: SetNull)
  socialAngle      String?              @map("social_angle")
  /// Ordre de passage : plus haut = publié plus tôt. À égalité, le plus
  /// ancien d'abord. 0 = normal.
  /// Post « engagement » : image et description seules — l'extension ne pose
  /// pas de premier commentaire.
  noComment        Boolean              @default(false) @map("no_comment")
  priority         Int                  @default(0)
  /// Ses propres règles de duplication. NULL = le réglage global.
  repeatTimes      Int?                 @map("repeat_times")
  repeatEveryHours Int?                 @map("repeat_every_hours")
  targets          PostTarget[]
  jobItems         PublicationJobItem[]
  logs             ActivityLog[]
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@unique([sourceType, externalId])
  @@index([profileId, status])
  @@index([ownerId])
  @@index([articleId])
  @@index([visualId])
  @@index([priority, createdAt])
  @@map("posts")
}

/// Un site WordPress avec lequel on travaille : il nous envoie ses articles,
/// et on peut y déposer des reprises. Déclaré dans la plateforme pour qu'une
/// extension puisse choisir où publier.
model ContentSource {
  id              String           @id @default(cuid())
  name            String
  originUrl       String           @unique @map("origin_url")
  /// Clé du plugin de CE site. Vide : la clé globale WORDPRESS_API_KEY sert.
  /// Deux sites n'ont aucune raison de partager la même.
  depositKey      String?          @map("deposit_key")
  /// Un site inactif n'est plus proposé comme destination ; ses articles et
  /// ses posts restent intacts.
  ownerId         String?          @map("owner_id")
  owner           User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /// Ses articles partent vers les groupes de cette catégorie.
  categoryId      String?          @map("category_id")
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status          RecordStatus     @default(ACTIVE)
  /// L'extension WordPress de ce site : la dernière vérification de sa
  /// route `dfb/v1/status`, et le dernier article qu'elle nous a envoyé.
  pluginState     PluginState      @default(UNKNOWN) @map("plugin_state")
  pluginVersion   String?          @map("plugin_version")
  pluginMessage   String?          @map("plugin_message") @db.Text
  pluginCheckedAt DateTime?        @map("plugin_checked_at")
  lastDeliveryAt  DateTime?        @map("last_delivery_at")
  articles        Article[]
  ignoredArticles IgnoredArticle[]
  access          SiteAccess[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@index([ownerId])
  @@index([categoryId])
  @@map("content_sources")
}

/// Un article reçu pendant que son site était désactivé : ignoré, et
/// retenu comme tel. Sans cette trace, WordPress le renverrait à sa première
/// modification et il serait créé après coup — alors que la désactivation
/// dit précisément de ne pas le prendre.
model IgnoredArticle {
  id         String        @id @default(cuid())
  sourceId   String        @map("source_id")
  source     ContentSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// Même identifiant que `Article.externalId` : `wordpress:<id du post>`.
  externalId String        @map("external_id")
  title      String
  reason     String
  createdAt  DateTime      @default(now()) @map("created_at")

  @@unique([sourceId, externalId])
  @@map("ignored_articles")
}

/// Un site partagé avec un compte : il peut y déposer des reprises, sans
/// pouvoir le renommer, le désactiver ni lire sa clé.
model SiteAccess {
  id        String        @id @default(cuid())
  sourceId  String        @map("source_id")
  source    ContentSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  userId    String        @map("user_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy String?       @map("granted_by")
  createdAt DateTime      @default(now()) @map("created_at")

  @@unique([sourceId, userId])
  @@index([userId])
  @@map("site_access")
}

model Article {
  id              String        @id @default(cuid())
  sourceId        String        @map("source_id")
  source          ContentSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId      String        @map("external_id")
  jsonUrl         String        @map("json_url")
  title           String
  slug            String
  excerpt         String?       @db.Text
  metaDescription String?       @map("meta_description") @db.Text
  articleUrl      String        @map("article_url")
  coverImageUrl   String?       @map("cover_image_url")
  course          String?
  cuisine         String?
  servings        String?
  prepMinutes     Int?          @map("prep_minutes")
  cookMinutes     Int?          @map("cook_minutes")
  totalMinutes    Int?          @map("total_minutes")
  calories        Int?
  publishedAt     DateTime?     @map("published_at")
  captions        Json
  hashtags        String[]
  imagePrompt     String?       @map("image_prompt") @db.Text
  rawData         Json          @map("raw_data")
  status          RecordStatus  @default(ACTIVE)
  /// Priorité de TOUS ses posts (les existants, et ceux créés ensuite).
  priority        Int           @default(0)
  /// Posé à la première publication d'un de ses posts : l'article a servi,
  /// on n'en tire plus de nouveau post. Son post déjà créé finit sa tournée
  /// des groupes (chacun le reçoit une fois).
  archivedAt      DateTime?     @map("archived_at")
  posts           Post[]
  ingest          SourceIngest?
  importedAt      DateTime      @default(now()) @map("imported_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([sourceId, externalId])
  @@unique([sourceId, slug])
  @@index([publishedAt])
  @@map("articles")
}

/// Reprise d'une publication Facebook existante : l'extension en rapporte
/// l'image et le texte, la page source fournit le fond, et l'ensemble
/// ressort en article réécrit puis en nouveau post.
model SourceIngest {
  id          String @id @default(cuid())
  facebookUrl String @map("facebook_url")
  sourceUrl   String @map("source_url")
  /// Site WordPress de destination, origine seule, sans barre finale.
  siteUrl     String @map("site_url")
  language    String @default("en")

  /// `rewrite` : réécrire l'article d'un site source (sourceUrl).
  /// `news`    : créer NOTRE article à partir de l'image seule, rapprochée de
  ///             l'actualité du moment (sourceText garde les titres utilisés).
  mode           String  @default("rewrite")
  /// Mode « engagement » : la langue cible (image traduite, description, et
  /// groupes de cette langue).
  targetLanguage String? @map("target_language")
  /// Ce que l'extension rapporte du post d'origine.
  fbCaption      String? @map("fb_caption") @db.Text
  fbImageUrl     String? @map("fb_image_url")
  /// Ce que la page source fournit, gardé pour rejouer la réécriture sans
  /// retourner la chercher.
  sourceTitle    String? @map("source_title")
  sourceText     String? @map("source_text") @db.Text

  /// Sortie du modèle, telle quelle.
  generated   Json?
  wpPostId    String?  @map("wp_post_id")
  wpPermalink String?  @map("wp_permalink")
  /// Rempli au retour du plugin : la boucle est fermée.
  articleId   String?  @unique @map("article_id")
  article     Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  /// Qui a lancé la reprise. NULL pour celles nées de la clé globale.
  ownerId String? @map("owner_id")
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  /// Portée de la diffusion. Vide = tous les profils actifs et leurs groupes.
  profileIds String[] @map("profile_ids")
  groupIds   String[] @map("group_ids")

  status         IngestStatus @default(PENDING_SCRAPE)
  /// Réservation de l'étape de collecte par une extension, même mécanique
  /// que les lots de publication : une réservation expirée revient au stock.
  claimedAt      DateTime?    @map("claimed_at")
  claimExpiresAt DateTime?    @map("claim_expires_at")
  attempts       Int          @default(0)
  lastError      String?      @map("last_error") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([ownerId])
  @@map("source_ingests")
}

model AutomationSetting {
  id                         String   @id @default("global")
  autoReplenishEnabled       Boolean  @default(true) @map("auto_replenish_enabled")
  /// Coupe-circuit : a false, aucun profil ne publie, quel que soit son mode.
  /// Un seul interrupteur a couper quand quelque chose tourne mal.
  publishingEnabled          Boolean  @default(true) @map("publishing_enabled")
  minimumAvailablePerProfile Int      @default(10) @map("minimum_available_per_profile")
  minimumAvailablePerGroup   Int      @default(8) @map("minimum_available_per_group")
  /// L'objectif de publications par jour (0 = pas d'objectif), et la plage
  /// horaire sur laquelle on l'étale : c'est elle qui dit si l'on est en
  /// avance ou en retard à une heure donnée.
  dailyTarget                Int      @default(0) @map("daily_target")
  objectiveStart             Int      @default(480) @map("objective_start")
  objectiveEnd               Int      @default(1320) @map("objective_end")
  objectiveTimezone          String   @default("Europe/Paris") @map("objective_timezone")
  /// La duplication des contenus : combien de fois chaque post part dans un
  /// même groupe (1 = une seule fois, le cas par défaut), et l'écart entre
  /// deux publications. Un post peut avoir les siens (`Post.repeatTimes`).
  /// Un profil que Facebook limite (« We limit how often you can post… »)
  /// est mis en pause ce nombre de jours : il ne publie plus, ses posts
  /// passent aux autres profils.
  rateLimitPauseDays         Int      @default(5) @map("rate_limit_pause_days")
  /// L'IA qui traduit le texte d'une image (mode « engagement ») : `auto`
  /// (le premier configuré), `openai`, `qwen` ou `seedream`. Les clés restent
  /// dans l'environnement du serveur.
  imageProvider              String   @default("auto") @map("image_provider")
  repeatTimes                Int      @default(1) @map("repeat_times")
  repeatEveryHours           Int      @default(48) @map("repeat_every_hours")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("automation_settings")
}

model PostTarget {
  id                 String               @id @default(cuid())
  postId             String               @map("post_id")
  post               Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  groupId            String               @map("group_id")
  group              Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status             TargetStatus         @default(AVAILABLE)
  claimedAt          DateTime?            @map("claimed_at")
  claimExpiresAt     DateTime?            @map("claim_expires_at")
  consumedAt         DateTime?            @map("consumed_at")
  publishedAt        DateTime?            @map("published_at")
  commentExternalId  String?              @map("comment_external_id")
  commentedAt        DateTime?            @map("commented_at")
  linkUpdatedAt      DateTime?            @map("link_updated_at")
  attemptsCount      Int                  @default(0) @map("attempts_count")
  lastError          String?              @map("last_error") @db.Text
  /// Envoi forcé : ce profil prend cette cible en premier à son prochain
  /// passage, et aucun autre ne la prend entre-temps. NULL = file normale.
  forcedProfileId    String?              @map("forced_profile_id")
  forcedProfile      Profile?             @relation("ForcedTargets", fields: [forcedProfileId], references: [id], onDelete: SetNull)
  forcedAt           DateTime?            @map("forced_at")
  /// La vérification par le profil vérificateur : NULL = pas encore vérifié.
  /// Un post republié (REPUBLISHED) repasse en vérification une fois publié.
  verifyStatus       VerifyStatus?        @map("verify_status")
  verifiedAt         DateTime?            @map("verified_at")
  verifyDetail       String?              @map("verify_detail") @db.Text
  /// Réservé par un vérificateur jusqu'à cette heure (ou repoussé : en
  /// attente de modération, page injoignable).
  verifyClaimedUntil DateTime?            @map("verify_claimed_until")
  verifyAttempts     Int                  @default(0) @map("verify_attempts")
  /// Combien de fois la vérification l'a remis dans la file : plafonné, pour
  /// ne pas republier sans fin dans un groupe qui refuse.
  republishCount     Int                  @default(0) @map("republish_count")
  /// Le profil qui a publié une version incomplète (photo sans commentaire,
  /// « . » jamais remplacé par le lien) : la republication va à un AUTRE
  /// profil du groupe. NULL = n'importe lequel.
  avoidProfileId     String?              @map("avoid_profile_id")
  /// Combien de fois la duplication l'a remis dans la file, une fois l'écart
  /// écoulé : publications faites dans ce groupe = repeatRound + 1.
  repeatRound        Int                  @default(0) @map("repeat_round")
  /// L'adresse Facebook de la publication en ligne : donnée par l'extension
  /// de publication, retrouvée par le vérificateur, ou collée par l'admin.
  /// Effacée quand la publication est remise dans la file ; l'ancienne reste
  /// dans l'historique (`traces`).
  facebookUrl        String?              @map("facebook_url") @db.Text
  jobItems           PublicationJobItem[]
  logs               ActivityLog[]
  traces             PublicationTrace[]
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@unique([postId, groupId])
  @@index([groupId, status])
  @@index([forcedProfileId])
  @@index([status, verifyStatus])
  @@map("post_targets")
}

model PublicationJob {
  id             String               @id @default(cuid())
  profileId      String               @map("profile_id")
  profile        Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  groupId        String               @map("group_id")
  group          Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status         JobStatus            @default(CLAIMED)
  claimedAt      DateTime             @default(now()) @map("claimed_at")
  claimExpiresAt DateTime             @map("claim_expires_at")
  completedAt    DateTime?            @map("completed_at")
  items          PublicationJobItem[]
  logs           ActivityLog[]
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([profileId, groupId, status])
  @@map("publication_jobs")
}

/// L'historique d'une publication (un post dans un groupe), dans l'ordre :
/// publiée par qui et à quelle adresse, commentée, lien posé, vérifiée,
/// supprimée, republiée… Jamais modifié, jamais effacé avec un échec : c'est
/// ce qui permet de dire après coup ce qui s'est passé.
model PublicationTrace {
  id           String     @id @default(cuid())
  postTargetId String     @map("post_target_id")
  postTarget   PostTarget @relation(fields: [postTargetId], references: [id], onDelete: Cascade)
  kind         String
  /// L'adresse du post Facebook concerné, quand il y en a une.
  facebookUrl  String?    @map("facebook_url") @db.Text
  /// Qui : le nom du profil (publication, vérification) ou du compte admin.
  actor        String?
  profileId    String?    @map("profile_id")
  jobId        String?    @map("job_id")
  detail       String?    @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([postTargetId, createdAt])
  @@index([facebookUrl])
  @@map("publication_traces")
}

model PublicationJobItem {
  id                String         @id @default(cuid())
  jobId             String         @map("job_id")
  job               PublicationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  postId            String         @map("post_id")
  post              Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  postTargetId      String         @map("post_target_id")
  postTarget        PostTarget     @relation(fields: [postTargetId], references: [id], onDelete: Cascade)
  status            TargetStatus   @default(CLAIMED)
  externalPostUrl   String?        @map("external_post_url")
  publishedAt       DateTime?      @map("published_at")
  commentExternalId String?        @map("comment_external_id")
  commentedAt       DateTime?      @map("commented_at")
  linkUpdatedAt     DateTime?      @map("link_updated_at")
  error             String?        @db.Text
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@unique([jobId, postId])
  @@map("publication_job_items")
}

/// Le pilotage d'un profil : ce que l'admin veut, et ce que le terrain
/// rapporte. Deux moities dans la meme ligne parce qu'elles se lisent
/// toujours ensemble -- un interrupteur sans etat ne dit pas si l'ordre est
/// arrive.
///
/// Rien ici ne lance un navigateur : l'API de NSTBrowser est locale a la
/// machine. L'agent local lit `mode` et ouvre/ferme le profil, l'extension du
/// navigateur lit la meme chose et publie ou s'arrete.
model ProfileRunner {
  id        String  @id @default(cuid())
  profileId String  @unique @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  mode RunnerMode @default(OFF)

  /// Fenetre de publication, en minutes depuis minuit dans `timezone`.
  /// NULL = pas de limite. Un debut superieur a la fin traverse la nuit.
  windowStart Int?    @map("window_start")
  windowEnd   Int?    @map("window_end")
  /// Jours ISO autorises, "1,2,3,4,5" pour lundi-vendredi. Vide = tous.
  days        String? @map("days")
  timezone    String  @default("Europe/Paris")

  /// Reglages pousses au navigateur, fusionnes par-dessus ses valeurs par
  /// defaut : l'operateur n'a plus rien a regler profil par profil.
  settings Json?

  /// Le code d'appairage : ce que l'operateur colle UNE fois dans l'extension
  /// du navigateur, et qui lui apprend qui il est et comment parler a l'API.
  /// Court, a usage unique et perissable -- il vaut la cle d'automatisation le
  /// temps de l'echange, donc il ne doit pas trainer.
  pairCode          String?   @unique @map("pair_code")
  pairCodeExpiresAt DateTime? @map("pair_code_expires_at")
  /// Quand ce profil a ete appaire, et depuis quelle adresse : de quoi
  /// reconnaitre un navigateur qu'on a perdu de vue.
  pairedAt          DateTime? @map("paired_at")
  /// Empreinte (sha256) de la clé que le navigateur détient : remise à
  /// l'appairage, relue à chaque battement réussi. Si la clé actuelle du
  /// compte ne correspond plus, l'appairage est cassé, même si `pairedAt`
  /// dit le contraire.
  pairedKeyHash     String?   @map("paired_key_hash")
  /// L'identifiant NSTBrowser remis à l'appairage : s'il a changé depuis, le
  /// navigateur se présente sous un nom que l'API ne connaît plus.
  pairedExternalId  String?   @map("paired_external_id")
  /// Le dernier battement REFUSÉ de ce profil (clé inconnue, clé d'un autre
  /// compte) : le navigateur parle, mais n'est plus reconnu.
  keyRejectedAt     DateTime? @map("key_rejected_at")
  keyRejectReason   String?   @map("key_reject_reason")

  /// Ce que l'extension rapporte a chaque battement.
  lastSeenAt  DateTime? @map("last_seen_at")
  /// L'extension a fermé son navigateur pour rendre la mémoire entre deux
  /// lots : l'agent local ne le rouvre qu'à cette heure-là. NULL = éveillé.
  sleepUntil  DateTime? @map("sleep_until")
  /// En pause jusqu'à cette date : Facebook a limité ses publications. Il ne
  /// réserve plus rien ; levée seule à l'échéance, ou par l'admin.
  pausedUntil DateTime? @map("paused_until")
  pauseReason String?   @map("pause_reason") @db.Text
  /// Quota du profil : au plus N publications par jour (fuseau de l'objectif).
  /// NULL = pas de quota.
  dailyQuota  Int?      @map("daily_quota")
  running     Boolean   @default(false)
  phase       String?
  message     String?   @db.Text
  published   Int       @default(0)
  failed      Int       @default(0)
  links       Int       @default(0)
  agent       String?

  /// Ce que l'agent local rapporte sur le navigateur lui-meme.
  browserState   BrowserState @default(STOPPED) @map("browser_state")
  browserSeenAt  DateTime?    @map("browser_seen_at")
  browserMessage String?      @map("browser_message") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([mode])
  @@map("profile_runners")
}

model ActivityLog {
  id           String          @id @default(cuid())
  profileId    String?         @map("profile_id")
  profile      Profile?        @relation(fields: [profileId], references: [id], onDelete: SetNull)
  groupId      String?         @map("group_id")
  group        Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  postId       String?         @map("post_id")
  post         Post?           @relation(fields: [postId], references: [id], onDelete: SetNull)
  postTargetId String?         @map("post_target_id")
  postTarget   PostTarget?     @relation(fields: [postTargetId], references: [id], onDelete: SetNull)
  jobId        String?         @map("job_id")
  job          PublicationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  /// Le post Facebook concerné, quand il y en a un : filtrer et retrouver
  /// un événement par son lien, et l'ouvrir d'un clic.
  facebookUrl  String?         @map("facebook_url") @db.Text
  eventType    String          @map("event_type")
  level        LogLevel        @default(INFO)
  message      String
  metadata     Json?
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([postTargetId, createdAt])
  @@index([groupId, createdAt])
  @@index([facebookUrl])
  @@index([profileId, createdAt])
  @@map("activity_logs")
}

/// Une session de connexion à la plateforme. Le navigateur ne détient qu'un
/// jeton aléatoire, dans un cookie HttpOnly ; la base n'en garde que
/// l'empreinte. La déconnexion la révoque vraiment, et elle expire seule
/// (durée absolue et inactivité).
model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 du jeton : un vol de la base ne donne aucune session utilisable.
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  ip         String?
  userAgent  String?   @map("user_agent")

  @@index([userId])
  @@map("sessions")
}

/// Une version d'une de nos extensions Chrome, gardée pour toujours : c'est
/// l'historique et la sauvegarde. Les fichiers sont stockés tels quels (sans
/// clé) ; la clé du compte est injectée au téléchargement.
model ExtensionRelease {
  id        String   @id @default(cuid())
  /// publication | adhesion | capture | moderateur
  key       String
  version   String
  /// sha256 du contenu : deux versions identiques ne sont pas doublées.
  sha256    String
  size      Int
  fileCount Int      @map("file_count")
  /// [{ path, b64 }]
  files     Json
  notes     String?  @db.Text
  /// Épinglée par un admin : servie comme version courante (retour arrière).
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([key, version])
  @@index([key, createdAt])
  @@map("extension_releases")
}

/// Une image produite par la plateforme (image traduite d'un post
/// « engagement »). Servie publiquement sous un jeton imprévisible : les
/// extensions la téléchargent pour la publier.
model GeneratedImage {
  id        String   @id @default(cuid())
  token     String   @unique
  mimeType  String   @map("mime_type")
  data      Bytes
  ingestId  String?  @map("ingest_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("generated_images")
}

/// Un visuel : une image seule à publier dans les groupes — capturée sur
/// Facebook (mode « engagement ») ou importée. Pas d'article, pas de lien :
/// ses posts partent avec l'image et la description, sans commentaire.
model Visual {
  id         String       @id @default(cuid())
  title      String
  /// L'image publiée (servie par la plateforme : /media/g/<jeton>).
  imageUrl   String       @map("image_url")
  caption    String       @db.Text
  hashtags   String[]
  /// La langue du texte et des groupes visés (en, fr, ar…).
  language   String?
  categoryId String?      @map("category_id")
  category   Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// `capture` (extension Capture) ou `upload` (importé dans la plateforme).
  origin     String       @default("upload")
  ingestId   String?      @map("ingest_id")
  /// Le texte trouvé dans l'image et sa traduction, l'IA utilisée.
  details    Json?
  ownerId    String?      @map("owner_id")
  owner      User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  status     RecordStatus @default(ACTIVE)
  posts      Post[]
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([ownerId])
  @@map("visuals")
}
