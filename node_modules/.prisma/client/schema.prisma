generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

/// Adhésion du compte Facebook (profil) au groupe, renseignée par l'extension.
enum JoinStatus {
  NOT_JOINED
  REQUESTED
  JOINED
  QUESTIONS
  FAILED
}

enum PostStatus {
  DRAFT
  AVAILABLE
  ARCHIVED
}

enum SourceType {
  MANUAL
  OPENAI
  JSON
  FACEBOOK
}

enum TargetStatus {
  AVAILABLE
  CLAIMED
  CONSUMED
  PUBLISHED
  FAILED
  CANCELLED
}

enum JobStatus {
  CLAIMED
  /// Tout est publié et commenté : il reste à basculer les commentaires sur l'URL.
  AWAITING_LINK
  PARTIALLY_COMPLETED
  COMPLETED
  FAILED
  EXPIRED
}

/// Étapes d'une reprise : chacune est le point de reprise après une panne.
enum IngestStatus {
  PENDING_SCRAPE
  SCRAPING
  SCRAPED
  REWRITING
  REWRITTEN
  PUBLISHING
  AWAITING_ECHO
  COMPLETED
  FAILED
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

model Profile {
  id                       String           @id @default(cuid())
  name                     String
  externalId               String?          @unique @map("external_id")
  defaultImageUrl          String?          @map("default_image_url")
  minPostsPerJob           Int              @default(2) @map("min_posts_per_job")
  maxPostsPerJob           Int              @default(6) @map("max_posts_per_job")
  /// Seuils d'alimentation propres au profil. NULL = suivre le réglage global.
  minimumAvailable         Int?             @map("minimum_available")
  minimumAvailablePerGroup Int?             @map("minimum_available_per_group")
  status                   RecordStatus     @default(ACTIVE)
  profileGroups            ProfileGroup[]
  posts                    Post[]
  publicationJobs          PublicationJob[]
  logs                     ActivityLog[]
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")

  @@map("profiles")
}

model Group {
  id              String           @id @default(cuid())
  name            String
  externalId      String?          @unique @map("external_id")
  url             String
  status          RecordStatus     @default(ACTIVE)
  profiles        ProfileGroup[]
  targets         PostTarget[]
  publicationJobs PublicationJob[]
  logs            ActivityLog[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@map("groups")
}

model ProfileGroup {
  id            String       @id @default(cuid())
  profileId     String       @map("profile_id")
  profile       Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  groupId       String       @map("group_id")
  group         Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status        RecordStatus @default(ACTIVE)
  joinStatus    JoinStatus   @default(NOT_JOINED) @map("join_status")
  joinCheckedAt DateTime?    @map("join_checked_at")
  joinError     String?      @map("join_error") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@unique([profileId, groupId])
  @@index([groupId, status])
  @@index([profileId, joinStatus])
  @@map("profile_groups")
}

model Post {
  id          String               @id @default(cuid())
  profileId   String               @map("profile_id")
  profile     Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String               @db.Text
  url         String?
  imageUrl    String?              @map("image_url")
  delay       Int
  sourceType  SourceType           @default(MANUAL) @map("source_type")
  externalId  String?              @map("external_id")
  status      PostStatus           @default(AVAILABLE)
  rawData     Json?                @map("raw_data")
  articleId   String?              @map("article_id")
  article     Article?             @relation(fields: [articleId], references: [id], onDelete: SetNull)
  socialAngle String?              @map("social_angle")
  targets     PostTarget[]
  jobItems    PublicationJobItem[]
  logs        ActivityLog[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@unique([sourceType, externalId])
  @@index([profileId, status])
  @@index([articleId])
  @@map("posts")
}

model ContentSource {
  id        String    @id @default(cuid())
  name      String
  originUrl String    @unique @map("origin_url")
  articles  Article[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("content_sources")
}

model Article {
  id              String        @id @default(cuid())
  sourceId        String        @map("source_id")
  source          ContentSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId      String        @map("external_id")
  jsonUrl         String        @map("json_url")
  title           String
  slug            String
  excerpt         String?       @db.Text
  metaDescription String?       @map("meta_description") @db.Text
  articleUrl      String        @map("article_url")
  coverImageUrl   String?       @map("cover_image_url")
  course          String?
  cuisine         String?
  servings        String?
  prepMinutes     Int?          @map("prep_minutes")
  cookMinutes     Int?          @map("cook_minutes")
  totalMinutes    Int?          @map("total_minutes")
  calories        Int?
  publishedAt     DateTime?     @map("published_at")
  captions        Json
  hashtags        String[]
  imagePrompt     String?       @map("image_prompt") @db.Text
  rawData         Json          @map("raw_data")
  status          RecordStatus  @default(ACTIVE)
  posts           Post[]
  ingest          SourceIngest?
  importedAt      DateTime      @default(now()) @map("imported_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([sourceId, externalId])
  @@unique([sourceId, slug])
  @@index([publishedAt])
  @@map("articles")
}

/// Reprise d'une publication Facebook existante : l'extension en rapporte
/// l'image et le texte, la page source fournit le fond, et l'ensemble
/// ressort en article réécrit puis en nouveau post.
model SourceIngest {
  id          String @id @default(cuid())
  facebookUrl String @map("facebook_url")
  sourceUrl   String @map("source_url")
  /// Site WordPress de destination, origine seule, sans barre finale.
  siteUrl     String @map("site_url")
  language    String @default("en")

  /// Ce que l'extension rapporte du post d'origine.
  fbCaption   String? @map("fb_caption") @db.Text
  fbImageUrl  String? @map("fb_image_url")
  /// Ce que la page source fournit, gardé pour rejouer la réécriture sans
  /// retourner la chercher.
  sourceTitle String? @map("source_title")
  sourceText  String? @map("source_text") @db.Text

  /// Sortie du modèle, telle quelle.
  generated   Json?
  wpPostId    String?  @map("wp_post_id")
  wpPermalink String?  @map("wp_permalink")
  /// Rempli au retour du plugin : la boucle est fermée.
  articleId   String?  @unique @map("article_id")
  article     Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  /// Portée de la diffusion. Vide = tous les profils actifs et leurs groupes.
  profileIds String[] @map("profile_ids")
  groupIds   String[] @map("group_ids")

  status         IngestStatus @default(PENDING_SCRAPE)
  /// Réservation de l'étape de collecte par une extension, même mécanique
  /// que les lots de publication : une réservation expirée revient au stock.
  claimedAt      DateTime?    @map("claimed_at")
  claimExpiresAt DateTime?    @map("claim_expires_at")
  attempts       Int          @default(0)
  lastError      String?      @map("last_error") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("source_ingests")
}

model AutomationSetting {
  id                         String   @id @default("global")
  autoReplenishEnabled       Boolean  @default(true) @map("auto_replenish_enabled")
  minimumAvailablePerProfile Int      @default(10) @map("minimum_available_per_profile")
  minimumAvailablePerGroup   Int      @default(8) @map("minimum_available_per_group")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("automation_settings")
}

model PostTarget {
  id                String               @id @default(cuid())
  postId            String               @map("post_id")
  post              Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  groupId           String               @map("group_id")
  group             Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status            TargetStatus         @default(AVAILABLE)
  claimedAt         DateTime?            @map("claimed_at")
  claimExpiresAt    DateTime?            @map("claim_expires_at")
  consumedAt        DateTime?            @map("consumed_at")
  publishedAt       DateTime?            @map("published_at")
  commentExternalId String?              @map("comment_external_id")
  commentedAt       DateTime?            @map("commented_at")
  linkUpdatedAt     DateTime?            @map("link_updated_at")
  attemptsCount     Int                  @default(0) @map("attempts_count")
  lastError         String?              @map("last_error") @db.Text
  jobItems          PublicationJobItem[]
  logs              ActivityLog[]
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@unique([postId, groupId])
  @@index([groupId, status])
  @@map("post_targets")
}

model PublicationJob {
  id             String               @id @default(cuid())
  profileId      String               @map("profile_id")
  profile        Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  groupId        String               @map("group_id")
  group          Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status         JobStatus            @default(CLAIMED)
  claimedAt      DateTime             @default(now()) @map("claimed_at")
  claimExpiresAt DateTime             @map("claim_expires_at")
  completedAt    DateTime?            @map("completed_at")
  items          PublicationJobItem[]
  logs           ActivityLog[]
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([profileId, groupId, status])
  @@map("publication_jobs")
}

model PublicationJobItem {
  id                String         @id @default(cuid())
  jobId             String         @map("job_id")
  job               PublicationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  postId            String         @map("post_id")
  post              Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  postTargetId      String         @map("post_target_id")
  postTarget        PostTarget     @relation(fields: [postTargetId], references: [id], onDelete: Cascade)
  status            TargetStatus   @default(CLAIMED)
  externalPostUrl   String?        @map("external_post_url")
  publishedAt       DateTime?      @map("published_at")
  commentExternalId String?        @map("comment_external_id")
  commentedAt       DateTime?      @map("commented_at")
  linkUpdatedAt     DateTime?      @map("link_updated_at")
  error             String?        @db.Text
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@unique([jobId, postId])
  @@map("publication_job_items")
}

model ActivityLog {
  id           String          @id @default(cuid())
  profileId    String?         @map("profile_id")
  profile      Profile?        @relation(fields: [profileId], references: [id], onDelete: SetNull)
  groupId      String?         @map("group_id")
  group        Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  postId       String?         @map("post_id")
  post         Post?           @relation(fields: [postId], references: [id], onDelete: SetNull)
  postTargetId String?         @map("post_target_id")
  postTarget   PostTarget?     @relation(fields: [postTargetId], references: [id], onDelete: SetNull)
  jobId        String?         @map("job_id")
  job          PublicationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  eventType    String          @map("event_type")
  level        LogLevel        @default(INFO)
  message      String
  metadata     Json?
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([profileId, createdAt])
  @@map("activity_logs")
}
