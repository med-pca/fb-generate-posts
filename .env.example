DATABASE_URL="postgresql://postgres:postgres@localhost:5432/data_fb_posting?schema=public"
PORT=3000
# Réécriture : les fournisseurs sont essayés dans cet ordre, et seuls ceux
# qui ont une clé entrent dans la chaîne. Le premier qui répond l'emporte.
LLM_PROVIDERS="openai,deepseek,gemini,kimi"
# Délai avant d'abandonner un fournisseur. Un fournisseur qui ne répond pas
# fait perdre ce délai à toute la chaîne. Surchargeable par fournisseur avec
# KIMI_TIMEOUT_MS, OPENAI_TIMEOUT_MS, GEMINI_TIMEOUT_MS.
LLM_TIMEOUT_MS="90000"

# Kimi / Moonshot. Passerelle internationale ; api.moonshot.cn est un autre
# compte, avec ses propres clés.
KIMI_API_KEY=""
KIMI_MODEL="kimi-k2.6"
KIMI_BASE_URL="https://api.moonshot.ai/v1"
# Schéma strict non vérifié côté Kimi : mode JSON libre par défaut.
KIMI_JSON_SCHEMA="false"

# OpenAI. Sert aussi à /admin/posts/generate, qui n'a pas de repli.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# DeepSeek. Schéma strict refusé par l'API : mode JSON libre.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-pro"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# Gemini, via sa passerelle compatible OpenAI.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
CLAIM_TTL_MINUTES=30
# Cadence de l'alimentation automatique des posts. 0 désactive le minuteur.
REPLENISH_INTERVAL_MINUTES=15
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTOMATION_API_KEY="replace-with-a-long-random-api-key"

# Clé dédiée au plugin WordPress (distincte de la clé des automates).
WORDPRESS_API_KEY="replace-with-a-long-random-wordpress-key"

# Site WordPress où déposer les reprises, si `siteUrl` n'est pas fourni.
WORDPRESS_SITE_URL="https://exemple.com"

# Pages par article déposé : l'article est coupé sur `<!--nextpage-->`, et
# chaque page vue en est une de plus pour la régie publicitaire. 1 rend
# l'article d'un seul tenant. Un article trop court fait moins de pages que
# demandé plutôt que des pages vides.
ARTICLE_PAGES="2"
