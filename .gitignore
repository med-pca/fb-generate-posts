# Secrets d'environnement. .env.example reste suivi comme modèle.
# Sans cette règle, un `git add .` remet .env dans l'index : c'est ce qui a
# annulé le commit e0411ed1.
.env
.env.*
!.env.example

# Caches locaux
coverage/
dist/tsconfig.tsbuildinfo

# Paquets d’extensions : fabriqués par la plateforme (rubrique Extensions),
# jamais suivis — un paquet préconfiguré contient une clé d’API.
extension/*.zip
extension/**/dist/
