generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

/// Adhésion du compte Facebook (profil) au groupe, renseignée par l'extension.
enum JoinStatus {
  NOT_JOINED
  REQUESTED
  JOINED
  QUESTIONS
  FAILED
}

enum PostStatus {
  DRAFT
  AVAILABLE
  ARCHIVED
}

enum SourceType {
  MANUAL
  OPENAI
  JSON
  FACEBOOK
}

enum TargetStatus {
  AVAILABLE
  CLAIMED
  CONSUMED
  PUBLISHED
  FAILED
  CANCELLED
}

enum JobStatus {
  CLAIMED
  /// Tout est publié et commenté : il reste à basculer les commentaires sur l'URL.
  AWAITING_LINK
  PARTIALLY_COMPLETED
  COMPLETED
  FAILED
  EXPIRED
}

/// Étapes d'une reprise : chacune est le point de reprise après une panne.
enum IngestStatus {
  PENDING_SCRAPE
  SCRAPING
  SCRAPED
  REWRITING
  REWRITTEN
  PUBLISHING
  AWAITING_ECHO
  COMPLETED
  FAILED
}

/// Un ADMIN voit et gère tout. Un MANAGER ne voit que ce qu'il possède et
/// ce qu'on a partagé avec lui.
enum Role {
  ADMIN
  MANAGER
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

/// Ce que l'admin veut d'un profil. AUTO = il publie dans sa fenetre horaire,
/// ON = tout de suite et sans fenetre, OFF = il s'arrete.
enum RunnerMode {
  OFF
  ON
  AUTO
}

/// Ou en est le navigateur du profil, tel que l'agent local le rapporte.
/// L'API ne peut pas l'ouvrir elle-meme : le client NSTBrowser n'ecoute que
/// sur la machine ou il tourne.
enum BrowserState {
  STOPPED
  STARTING
  RUNNING
  ERROR
}

/// Un compte de la plateforme. Le premier ADMIN naît des identifiants du
/// `.env` à la première connexion : une installation existante n'a rien à
/// faire pour continuer à fonctionner.
/// L'état de l'extension WordPress d'un site, vu depuis la plateforme.
enum PluginState {
  UNKNOWN // jamais vérifié
  CONNECTED // la route répond et accepte la clé
  BAD_KEY // l'extension répond, mais refuse la clé
  MISSING // pas d'extension (ou désactivée)
  OUTDATED // ancienne extension (< 1.2.2) : envoie ses articles, sans route de statut ni réception des reprises
  UNREACHABLE // le site ne répond pas
}

/// Le thème commun à des groupes et des sites : c'est lui qui relie un
/// article à ses groupes de diffusion. Une liste gérée, pour qu'un « Recettes »
/// et un « recette » ne fassent pas deux thèmes.
model Category {
  id        String          @id @default(cuid())
  name      String          @unique
  groups    Group[]
  sites     ContentSource[]
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@map("categories")
}

model User {
  id            String          @id @default(cuid())
  username      String          @unique
  /// `sel:empreinte`, scrypt. Le mot de passe n'est jamais stocké.
  passwordHash  String          @map("password_hash")
  role          Role            @default(MANAGER)
  status        RecordStatus    @default(ACTIVE)
  /// Sa clé d'automatisation : son extension et son automate ne verront que
  /// son périmètre. Une clé par compte, sans quoi chacun atteindrait la file
  /// de tous les autres.
  automationKey String          @unique @map("automation_key")
  /// La clé de l'API locale de NSTBrowser de ce compte. L'agent local la
  /// reçoit avec son plan, profil par profil : chaque compte ouvre ses
  /// navigateurs avec son propre abonnement, sans toucher au `.env` de la
  /// machine. NULL = l'agent retombe sur son `NST_API_KEY`.
  nstApiKey     String?         @map("nst_api_key")
  /// Ce que ce compte possède. Supprimer un compte ne détruit rien : ses
  /// ressources deviennent sans propriétaire, donc réservées aux ADMIN, qui
  /// peuvent les réattribuer.
  profiles      Profile[]
  groups        Group[]
  posts         Post[]
  sites         ContentSource[]
  ingests       SourceIngest[]
  /// Ce qu'on lui a partagé. Publier seulement : ni renommer, ni
  /// désactiver, ni supprimer, ni repartager.
  groupAccess   GroupAccess[]
  siteAccess    SiteAccess[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([status])
  @@map("users")
}

model Profile {
  id                       String           @id @default(cuid())
  name                     String
  externalId               String?          @unique @map("external_id")
  defaultImageUrl          String?          @map("default_image_url")
  minPostsPerJob           Int              @default(2) @map("min_posts_per_job")
  maxPostsPerJob           Int              @default(6) @map("max_posts_per_job")
  /// Seuils d'alimentation propres au profil. NULL = suivre le réglage global.
  minimumAvailable         Int?             @map("minimum_available")
  minimumAvailablePerGroup Int?             @map("minimum_available_per_group")
  /// Qui possède cette ressource. NULL = sans propriétaire : seuls les
  /// ADMIN la voient, en attendant qu'on la réattribue.
  ownerId                  String?          @map("owner_id")
  owner                    User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  status                   RecordStatus     @default(ACTIVE)
  /// Son pilotage : marche/arret, fenetre horaire, et ce que son navigateur
  /// rapporte. Absent = jamais pilote (donc a l'arret).
  runner                   ProfileRunner?
  profileGroups            ProfileGroup[]
  posts                    Post[]
  forcedTargets            PostTarget[]     @relation("ForcedTargets")
  publicationJobs          PublicationJob[]
  logs                     ActivityLog[]
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("profiles")
}

model Group {
  id              String           @id @default(cuid())
  name            String
  externalId      String?          @unique @map("external_id")
  url             String
  ownerId         String?          @map("owner_id")
  owner           User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /// Le thème du groupe. Un article reçu d'un site de la même catégorie
  /// devient un post qui vise tous ces groupes à la fois.
  categoryId      String?          @map("category_id")
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status          RecordStatus     @default(ACTIVE)
  profiles        ProfileGroup[]
  targets         PostTarget[]
  publicationJobs PublicationJob[]
  logs            ActivityLog[]
  access          GroupAccess[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@index([ownerId])
  @@index([categoryId])
  @@map("groups")
}

/// Un groupe partagé avec un compte, en publication seule. Une table par
/// ressource plutôt qu'un système de permissions générique : les requêtes
/// restent lisibles, et on voit d'un coup d'œil qui a accès à quoi.
model GroupAccess {
  id        String   @id @default(cuid())
  groupId   String   @map("group_id")
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Qui a partagé, pour que le propriétaire sache d'où vient un accès.
  grantedBy String?  @map("granted_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_access")
}

model ProfileGroup {
  id            String       @id @default(cuid())
  profileId     String       @map("profile_id")
  profile       Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  groupId       String       @map("group_id")
  group         Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status        RecordStatus @default(ACTIVE)
  joinStatus    JoinStatus   @default(NOT_JOINED) @map("join_status")
  joinCheckedAt DateTime?    @map("join_checked_at")
  joinError     String?      @map("join_error") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@unique([profileId, groupId])
  @@index([groupId, status])
  @@index([profileId, joinStatus])
  @@map("profile_groups")
}

model Post {
  id          String               @id @default(cuid())
  /// NULL = post ouvert : n'importe quel profil qui a rejoint l'un de ses
  /// groupes peut le publier, et chaque groupe ne le reçoit qu'une fois.
  profileId   String?              @map("profile_id")
  profile     Profile?             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// À qui appartient un post ouvert (il n'a pas de profil pour le dire).
  /// Seuls les profils de ce compte le publient. NULL = tous.
  ownerId     String?              @map("owner_id")
  owner       User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  title       String
  description String               @db.Text
  url         String?
  imageUrl    String?              @map("image_url")
  delay       Int
  sourceType  SourceType           @default(MANUAL) @map("source_type")
  externalId  String?              @map("external_id")
  status      PostStatus           @default(AVAILABLE)
  rawData     Json?                @map("raw_data")
  articleId   String?              @map("article_id")
  article     Article?             @relation(fields: [articleId], references: [id], onDelete: SetNull)
  socialAngle String?              @map("social_angle")
  /// Ordre de passage : plus haut = publié plus tôt. À égalité, le plus
  /// ancien d'abord. 0 = normal.
  priority    Int                  @default(0)
  targets     PostTarget[]
  jobItems    PublicationJobItem[]
  logs        ActivityLog[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@unique([sourceType, externalId])
  @@index([profileId, status])
  @@index([ownerId])
  @@index([articleId])
  @@index([priority, createdAt])
  @@map("posts")
}

/// Un site WordPress avec lequel on travaille : il nous envoie ses articles,
/// et on peut y déposer des reprises. Déclaré dans la plateforme pour qu'une
/// extension puisse choisir où publier.
model ContentSource {
  id              String       @id @default(cuid())
  name            String
  originUrl       String       @unique @map("origin_url")
  /// Clé du plugin de CE site. Vide : la clé globale WORDPRESS_API_KEY sert.
  /// Deux sites n'ont aucune raison de partager la même.
  depositKey      String?      @map("deposit_key")
  /// Un site inactif n'est plus proposé comme destination ; ses articles et
  /// ses posts restent intacts.
  ownerId         String?      @map("owner_id")
  owner           User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /// Ses articles partent vers les groupes de cette catégorie.
  categoryId      String?      @map("category_id")
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status          RecordStatus @default(ACTIVE)
  /// L'extension WordPress de ce site : la dernière vérification de sa
  /// route `dfb/v1/status`, et le dernier article qu'elle nous a envoyé.
  pluginState     PluginState  @default(UNKNOWN) @map("plugin_state")
  pluginVersion   String?      @map("plugin_version")
  pluginMessage   String?      @map("plugin_message") @db.Text
  pluginCheckedAt DateTime?    @map("plugin_checked_at")
  lastDeliveryAt  DateTime?    @map("last_delivery_at")
  articles        Article[]
  access          SiteAccess[]
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@index([ownerId])
  @@index([categoryId])
  @@map("content_sources")
}

/// Un site partagé avec un compte : il peut y déposer des reprises, sans
/// pouvoir le renommer, le désactiver ni lire sa clé.
model SiteAccess {
  id        String        @id @default(cuid())
  sourceId  String        @map("source_id")
  source    ContentSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  userId    String        @map("user_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy String?       @map("granted_by")
  createdAt DateTime      @default(now()) @map("created_at")

  @@unique([sourceId, userId])
  @@index([userId])
  @@map("site_access")
}

model Article {
  id              String        @id @default(cuid())
  sourceId        String        @map("source_id")
  source          ContentSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId      String        @map("external_id")
  jsonUrl         String        @map("json_url")
  title           String
  slug            String
  excerpt         String?       @db.Text
  metaDescription String?       @map("meta_description") @db.Text
  articleUrl      String        @map("article_url")
  coverImageUrl   String?       @map("cover_image_url")
  course          String?
  cuisine         String?
  servings        String?
  prepMinutes     Int?          @map("prep_minutes")
  cookMinutes     Int?          @map("cook_minutes")
  totalMinutes    Int?          @map("total_minutes")
  calories        Int?
  publishedAt     DateTime?     @map("published_at")
  captions        Json
  hashtags        String[]
  imagePrompt     String?       @map("image_prompt") @db.Text
  rawData         Json          @map("raw_data")
  status          RecordStatus  @default(ACTIVE)
  /// Posé à la première publication d'un de ses posts : l'article a servi,
  /// on n'en tire plus de nouveau post. Son post déjà créé finit sa tournée
  /// des groupes (chacun le reçoit une fois).
  archivedAt      DateTime?     @map("archived_at")
  posts           Post[]
  ingest          SourceIngest?
  importedAt      DateTime      @default(now()) @map("imported_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([sourceId, externalId])
  @@unique([sourceId, slug])
  @@index([publishedAt])
  @@map("articles")
}

/// Reprise d'une publication Facebook existante : l'extension en rapporte
/// l'image et le texte, la page source fournit le fond, et l'ensemble
/// ressort en article réécrit puis en nouveau post.
model SourceIngest {
  id          String @id @default(cuid())
  facebookUrl String @map("facebook_url")
  sourceUrl   String @map("source_url")
  /// Site WordPress de destination, origine seule, sans barre finale.
  siteUrl     String @map("site_url")
  language    String @default("en")

  /// Ce que l'extension rapporte du post d'origine.
  fbCaption   String? @map("fb_caption") @db.Text
  fbImageUrl  String? @map("fb_image_url")
  /// Ce que la page source fournit, gardé pour rejouer la réécriture sans
  /// retourner la chercher.
  sourceTitle String? @map("source_title")
  sourceText  String? @map("source_text") @db.Text

  /// Sortie du modèle, telle quelle.
  generated   Json?
  wpPostId    String?  @map("wp_post_id")
  wpPermalink String?  @map("wp_permalink")
  /// Rempli au retour du plugin : la boucle est fermée.
  articleId   String?  @unique @map("article_id")
  article     Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  /// Qui a lancé la reprise. NULL pour celles nées de la clé globale.
  ownerId String? @map("owner_id")
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  /// Portée de la diffusion. Vide = tous les profils actifs et leurs groupes.
  profileIds String[] @map("profile_ids")
  groupIds   String[] @map("group_ids")

  status         IngestStatus @default(PENDING_SCRAPE)
  /// Réservation de l'étape de collecte par une extension, même mécanique
  /// que les lots de publication : une réservation expirée revient au stock.
  claimedAt      DateTime?    @map("claimed_at")
  claimExpiresAt DateTime?    @map("claim_expires_at")
  attempts       Int          @default(0)
  lastError      String?      @map("last_error") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([ownerId])
  @@map("source_ingests")
}

model AutomationSetting {
  id                         String   @id @default("global")
  autoReplenishEnabled       Boolean  @default(true) @map("auto_replenish_enabled")
  /// Coupe-circuit : a false, aucun profil ne publie, quel que soit son mode.
  /// Un seul interrupteur a couper quand quelque chose tourne mal.
  publishingEnabled          Boolean  @default(true) @map("publishing_enabled")
  minimumAvailablePerProfile Int      @default(10) @map("minimum_available_per_profile")
  minimumAvailablePerGroup   Int      @default(8) @map("minimum_available_per_group")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("automation_settings")
}

model PostTarget {
  id                String               @id @default(cuid())
  postId            String               @map("post_id")
  post              Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  groupId           String               @map("group_id")
  group             Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status            TargetStatus         @default(AVAILABLE)
  claimedAt         DateTime?            @map("claimed_at")
  claimExpiresAt    DateTime?            @map("claim_expires_at")
  consumedAt        DateTime?            @map("consumed_at")
  publishedAt       DateTime?            @map("published_at")
  commentExternalId String?              @map("comment_external_id")
  commentedAt       DateTime?            @map("commented_at")
  linkUpdatedAt     DateTime?            @map("link_updated_at")
  attemptsCount     Int                  @default(0) @map("attempts_count")
  lastError         String?              @map("last_error") @db.Text
  /// Envoi forcé : ce profil prend cette cible en premier à son prochain
  /// passage, et aucun autre ne la prend entre-temps. NULL = file normale.
  forcedProfileId   String?              @map("forced_profile_id")
  forcedProfile     Profile?             @relation("ForcedTargets", fields: [forcedProfileId], references: [id], onDelete: SetNull)
  forcedAt          DateTime?            @map("forced_at")
  jobItems          PublicationJobItem[]
  logs              ActivityLog[]
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@unique([postId, groupId])
  @@index([groupId, status])
  @@index([forcedProfileId])
  @@map("post_targets")
}

model PublicationJob {
  id             String               @id @default(cuid())
  profileId      String               @map("profile_id")
  profile        Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  groupId        String               @map("group_id")
  group          Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status         JobStatus            @default(CLAIMED)
  claimedAt      DateTime             @default(now()) @map("claimed_at")
  claimExpiresAt DateTime             @map("claim_expires_at")
  completedAt    DateTime?            @map("completed_at")
  items          PublicationJobItem[]
  logs           ActivityLog[]
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([profileId, groupId, status])
  @@map("publication_jobs")
}

model PublicationJobItem {
  id                String         @id @default(cuid())
  jobId             String         @map("job_id")
  job               PublicationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  postId            String         @map("post_id")
  post              Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  postTargetId      String         @map("post_target_id")
  postTarget        PostTarget     @relation(fields: [postTargetId], references: [id], onDelete: Cascade)
  status            TargetStatus   @default(CLAIMED)
  externalPostUrl   String?        @map("external_post_url")
  publishedAt       DateTime?      @map("published_at")
  commentExternalId String?        @map("comment_external_id")
  commentedAt       DateTime?      @map("commented_at")
  linkUpdatedAt     DateTime?      @map("link_updated_at")
  error             String?        @db.Text
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@unique([jobId, postId])
  @@map("publication_job_items")
}

/// Le pilotage d'un profil : ce que l'admin veut, et ce que le terrain
/// rapporte. Deux moities dans la meme ligne parce qu'elles se lisent
/// toujours ensemble -- un interrupteur sans etat ne dit pas si l'ordre est
/// arrive.
///
/// Rien ici ne lance un navigateur : l'API de NSTBrowser est locale a la
/// machine. L'agent local lit `mode` et ouvre/ferme le profil, l'extension du
/// navigateur lit la meme chose et publie ou s'arrete.
model ProfileRunner {
  id        String  @id @default(cuid())
  profileId String  @unique @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  mode RunnerMode @default(OFF)

  /// Fenetre de publication, en minutes depuis minuit dans `timezone`.
  /// NULL = pas de limite. Un debut superieur a la fin traverse la nuit.
  windowStart Int?    @map("window_start")
  windowEnd   Int?    @map("window_end")
  /// Jours ISO autorises, "1,2,3,4,5" pour lundi-vendredi. Vide = tous.
  days        String? @map("days")
  timezone    String  @default("Europe/Paris")

  /// Reglages pousses au navigateur, fusionnes par-dessus ses valeurs par
  /// defaut : l'operateur n'a plus rien a regler profil par profil.
  settings Json?

  /// Le code d'appairage : ce que l'operateur colle UNE fois dans l'extension
  /// du navigateur, et qui lui apprend qui il est et comment parler a l'API.
  /// Court, a usage unique et perissable -- il vaut la cle d'automatisation le
  /// temps de l'echange, donc il ne doit pas trainer.
  pairCode          String?   @unique @map("pair_code")
  pairCodeExpiresAt DateTime? @map("pair_code_expires_at")
  /// Quand ce profil a ete appaire, et depuis quelle adresse : de quoi
  /// reconnaitre un navigateur qu'on a perdu de vue.
  pairedAt          DateTime? @map("paired_at")
  /// Empreinte (sha256) de la clé que le navigateur détient : remise à
  /// l'appairage, relue à chaque battement réussi. Si la clé actuelle du
  /// compte ne correspond plus, l'appairage est cassé, même si `pairedAt`
  /// dit le contraire.
  pairedKeyHash     String?   @map("paired_key_hash")
  /// L'identifiant NSTBrowser remis à l'appairage : s'il a changé depuis, le
  /// navigateur se présente sous un nom que l'API ne connaît plus.
  pairedExternalId  String?   @map("paired_external_id")
  /// Le dernier battement REFUSÉ de ce profil (clé inconnue, clé d'un autre
  /// compte) : le navigateur parle, mais n'est plus reconnu.
  keyRejectedAt     DateTime? @map("key_rejected_at")
  keyRejectReason   String?   @map("key_reject_reason")

  /// Ce que l'extension rapporte a chaque battement.
  lastSeenAt DateTime? @map("last_seen_at")
  running    Boolean   @default(false)
  phase      String?
  message    String?   @db.Text
  published  Int       @default(0)
  failed     Int       @default(0)
  links      Int       @default(0)
  agent      String?

  /// Ce que l'agent local rapporte sur le navigateur lui-meme.
  browserState   BrowserState @default(STOPPED) @map("browser_state")
  browserSeenAt  DateTime?    @map("browser_seen_at")
  browserMessage String?      @map("browser_message") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([mode])
  @@map("profile_runners")
}

model ActivityLog {
  id           String          @id @default(cuid())
  profileId    String?         @map("profile_id")
  profile      Profile?        @relation(fields: [profileId], references: [id], onDelete: SetNull)
  groupId      String?         @map("group_id")
  group        Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  postId       String?         @map("post_id")
  post         Post?           @relation(fields: [postId], references: [id], onDelete: SetNull)
  postTargetId String?         @map("post_target_id")
  postTarget   PostTarget?     @relation(fields: [postTargetId], references: [id], onDelete: SetNull)
  jobId        String?         @map("job_id")
  job          PublicationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  eventType    String          @map("event_type")
  level        LogLevel        @default(INFO)
  message      String
  metadata     Json?
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([profileId, createdAt])
  @@map("activity_logs")
}
