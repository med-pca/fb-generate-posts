{
  "manifest_version": 3,
  "name": "Modérateur · PostFlow",
  "short_name": "Modérateur",
  "version": "1.10.0",
  "description": "Profil vérificateur : rouvre les posts publiés par les automates, vérifie qu'ils sont en ligne avec le lien de l'article, supprime ceux qui n'en ont pas et les fait republier.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://post.pulserecipe.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Modérateur : vérification et adhésions",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
