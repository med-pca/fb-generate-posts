{
  "manifest_version": 3,
  "name": "Modérateur · PostFlow",
  "short_name": "Modérateur",
  "version": "1.13.0",
  "description": "Modérateur de nos groupes : accepte et pré-approuve nos profils, valide nos posts en attente et sort du « Spam potentiel » les posts de nos profils. En option (plateforme) : vérifier les posts publiés, retirer nos comptes suspendus — avec de vrais gestes, à rythme humain.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://post.pulserecipe.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Modérateur : vérification et adhésions",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
